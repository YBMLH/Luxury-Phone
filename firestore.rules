rules_version = '2';

// Firestore security rules for LuxuryPhone24.
// Copy the whole content of this file into:
// Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any signed-in user whose UID exists as a document ID
    // in the "admins" collection.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validString(value, max) {
      return value is string && value.size() <= max;
    }

    // Products: everyone can browse, only admins can manage.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site content: everyone can read, only admins can edit.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Category background images: one small document per category, kept
    // separate from settings/site so several of them together can never
    // hit Firestore's 1 MiB single-document size limit.
    match /categoryImages/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shopfront photos, one document per branch, kept out of settings/site
    // for exactly the same reason.
    match /branchPhotos/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can place one (with strict validation), but only
    // admins can read, change or delete them. Customer data stays private.
    // hasOnly() blocks any extra/unknown fields from being injected.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'orderNumber', 'customerName', 'phone', 'secondaryPhone',
          'wilaya', 'commune', 'address', 'productId', 'productName',
          'productImage', 'price', 'quantity', 'deliveryFee', 'total',
          'color', 'storage', 'ram', 'notes', 'status', 'createdAt'
        ])
        && validString(request.resource.data.customerName, 100)
        && request.resource.data.customerName.size() >= 3
        && validString(request.resource.data.phone, 15)
        && request.resource.data.phone.size() >= 9
        && validString(request.resource.data.wilaya, 50)
        && validString(request.resource.data.commune, 100)
        && validString(request.resource.data.address, 300)
        && validString(request.resource.data.productName, 150)
        && validString(request.resource.data.notes, 500)
        && validString(request.resource.data.orderNumber, 20)
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'Pending';
      // courier, parcelNumber and stockApplied are set by the dashboard
      // after the order exists; they are absent from the create list above
      // on purpose, so a customer cannot pre-set them.
      allow read, update, delete: if isAdmin();
    }

    // Tracking: a customer can GET their own tracking document because its
    // ID is "orderNumber_phone" — you must know BOTH values to read it.
    // Listing the collection is never allowed.
    match /tracking/{trackingId} {
      allow get: if true;
      allow list: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'orderNumber', 'productName', 'status', 'createdAt'
        ])
        && validString(request.resource.data.orderNumber, 20)
        && request.resource.data.status == 'Pending';
      allow update, delete: if isAdmin();
    }

    // Customers: created/updated automatically when an order is placed.
    // Only admins can view the list.
    match /customers/{phone} {
      // Placing an order writes only these five fields. deliveredCount,
      // cancelledCount and blocked are deliberately absent: a customer must
      // never be able to reset their own record or unblock themselves.
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'wilaya', 'ordersCount', 'lastOrderAt'
        ])
        && validString(request.resource.data.fullName, 100)
        && validString(request.resource.data.phone, 15)
        && validString(request.resource.data.wilaya, 50);
      // Admins keep the delivery tally and the blocked flag.
      allow create, update, read, delete: if isAdmin();
    }

    // Blocklist: one document per blocked phone number, the number being the
    // document id. A customer's browser checks its own number before placing
    // an order, which needs `get`. `list` stays closed, so nobody can read
    // out who has been blocked — you can only ask about a number you already
    // know. Only admins write.
    match /blocklist/{phone} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Reviews: anyone may submit one, but only as approved:false, and only
    // admins can flip that flag. Nothing a customer writes is ever visible
    // on the storefront until the owner has read it.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'productId', 'productName', 'name', 'rating', 'comment',
          'approved', 'createdAt'
        ])
        && request.resource.data.approved == false
        && validString(request.resource.data.productId, 60)
        && validString(request.resource.data.productName, 150)
        && validString(request.resource.data.name, 60)
        && request.resource.data.name.size() >= 2
        && validString(request.resource.data.comment, 600)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Admins: each admin can read their own record (used by the app to
    // verify dashboard access). Writing is only done manually from the
    // Firebase Console — never from the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Activity log: an immutable audit trail of admin actions. Only admins
    // can write (the app logs its own actions) or read it; nothing may
    // ever be edited or deleted, so the trail can't be tampered with.
    match /activityLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
