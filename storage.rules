rules_version = '2';

// Firebase Storage rules for Luxury Phone.
// Copy the whole content of this file into:
// Firebase Console → Storage → Rules → Publish
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Product images: public to view, admin-only to upload.
    // Uploads must be real images and under 5 MB.
    match /products/{imageId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Nothing else is accessible.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
